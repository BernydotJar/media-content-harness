+MEDIA_FACTORY_PUBLIC_GET_PATHS = ("/robots.txt", "/sitemap.xml", "/llms.txt", "/llm.txt", "/opengraph-image")
+
+def public_get_path_patterns(key: str, product: dict[str, Any]) -> list[str]:
+    paths = product.get("public_get_paths", [])
+    require(isinstance(paths, list), "L0_REGISTRY", "public_get_paths must be a list")
+    require(all(isinstance(path, str) for path in paths), "L0_REGISTRY", "public GET paths must be strings")
+    require(len(paths) == len(set(paths)), "L0_REGISTRY", "duplicate public GET path")
+    require(not paths or (key == "media-factory" and product.get("access_policy") == "form_session_single_operator"), "L0_REGISTRY", "public discovery is authorized only for Media Factory form-session mode")
+    require(all(path in MEDIA_FACTORY_PUBLIC_GET_PATHS for path in paths), "L0_REGISTRY", "public discovery path is outside the reviewed exact allowlist")
+    return [path for path in MEDIA_FACTORY_PUBLIC_GET_PATHS if path in paths]
