     return 0
 
 
+MEDIA_FACTORY_PUBLIC_GET_PATHS = ("/robots.txt", "/sitemap.xml", "/llms.txt", "/llm.txt", "/opengraph-image")
+
+def validate_public_get_paths(key: str, policy: str, paths: list[str]) -> list[str]:
+    if not isinstance(paths, list) or any(not isinstance(path, str) for path in paths):
+        raise SystemExit("public GET paths must be a list of strings")
+    if len(paths) != len(set(paths)):
+        raise SystemExit("duplicate public GET path")
+    if paths and (key != "media-factory" or policy != "form_session_single_operator"):
+        raise SystemExit("public discovery is authorized only for Media Factory form-session mode")
+    if any(path not in MEDIA_FACTORY_PUBLIC_GET_PATHS for path in paths):
+        raise SystemExit("public discovery path is outside the reviewed exact allowlist")
+    return [path for path in MEDIA_FACTORY_PUBLIC_GET_PATHS if path in paths]
+
