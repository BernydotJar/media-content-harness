{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/media-treatment.schema.json",
  "title": "Media Director Treatment",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "mode",
    "human_eval_frequency",
    "intent",
    "source",
    "creative_hypothesis",
    "beats",
    "capcut_plan",
    "quality_contract",
    "critic_contract",
    "release"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "media-treatment.v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["MVP", "SHIP"] },
    "human_eval_frequency": { "enum": ["gated", "always", "minimal"] },
    "intent": {
      "type": "object",
      "required": ["title", "content_type", "objective", "audience_scope", "target_duration_seconds", "aspect_ratio"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "content_type": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "audience_scope": { "type": "string", "minLength": 1 },
        "target_duration_seconds": {
          "type": "array",
          "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "aspect_ratio": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["authorization", "locator", "scope_rule", "temporal_policy"],
      "properties": {
        "authorization": { "enum": ["explicit", "persisted-authorized", "blocked"] },
        "locator": { "type": "string", "minLength": 1 },
        "scope_rule": { "type": "string", "minLength": 1 },
        "temporal_policy": { "type": "string", "minLength": 1 }
      }
    },
    "creative_hypothesis": {
      "type": "object",
      "required": ["hook", "arc", "emotional_goal", "visual_language", "sound_language"],
      "properties": {
        "hook": { "type": "string", "minLength": 1 },
        "arc": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "emotional_goal": { "type": "string", "minLength": 1 },
        "visual_language": { "type": "string", "minLength": 1 },
        "sound_language": { "type": "string", "minLength": 1 }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "source_asset": { "type": ["string", "null"] },
          "desired_action": { "type": "string" },
          "duration_seconds": {
            "type": "array",
            "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
            "minItems": 2,
            "maxItems": 2
          },
          "crop_intent": { "type": "string" },
          "audio_intent": { "type": "string" }
        }
      }
    },
    "capcut_plan": { "type": "object" },
    "quality_contract": { "type": "object" },
    "critic_contract": { "type": "object" },
    "release": { "type": "object" }
  }
}
