{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tenant-media-profile.schema.json",
  "title": "Tenant Media Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "organization", "runtime_namespace", "browser_context_ref", "content_context", "audience_policy", "brand", "sources", "production_defaults"],
  "properties": {
    "schema_version": { "const": "tenant-media-profile.v1" },
    "tenant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "organization": { "type": "string", "minLength": 1, "maxLength": 200 },
    "territory": { "type": ["string", "null"], "maxLength": 200 },
    "runtime_namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "browser_context_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "content_context": { "enum": ["community", "public-affairs", "commercial", "nonprofit", "media"] },
    "audience_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sensitive_trait_targeting", "voter_microtargeting"],
      "properties": {
        "mode": { "const": "general-audience" },
        "sensitive_trait_targeting": { "const": false },
        "voter_microtargeting": { "const": false }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "logo_asset_key": { "type": ["string", "null"] },
        "mascot_asset_key": { "type": ["string", "null"] },
        "visual_language": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locator", "authorization", "match", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
          "locator": { "type": "string", "format": "uri" },
          "authorization": { "enum": ["explicit", "persisted-authorized"] },
          "match": { "enum": ["exact", "prefix"] },
          "purpose": { "enum": ["reference", "source"] }
        }
      }
    },
    "production_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "cadence", "duration_seconds"],
      "properties": {
        "aspect_ratio": { "enum": ["9:16", "1:1", "16:9"] },
        "cadence": { "enum": ["weekly", "on-demand"] },
        "duration_seconds": {
          "type": "array",
          "prefixItems": [{ "type": "number", "minimum": 1 }, { "type": "number", "minimum": 1 }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
