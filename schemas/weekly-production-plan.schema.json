{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/weekly-production-plan.schema.json",
  "title": "Weekly Media Production Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "tenant_id", "week_of", "cadence", "audience_mode", "source_authorization_snapshot", "content_dna_observation_ids", "jobs", "deliverables"],
  "properties": {
    "schema_version": { "const": "weekly-production-plan.v1" },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "tenant_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "week_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "cadence": { "const": "weekly" },
    "audience_mode": { "const": "general-audience" },
    "source_authorization_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "locator", "authorization", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "locator": { "type": "string", "format": "uri" },
          "authorization": { "enum": ["explicit", "persisted-authorized"] },
          "purpose": { "enum": ["source", "reference"] }
        }
      }
    },
    "content_dna_observation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "objective", "source_ids", "story_devices", "target", "pipeline", "initial_graph_node", "human_approval_required", "publication_action", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "objective": { "type": "string", "minLength": 1, "maxLength": 500 },
          "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "story_devices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["aspect_ratio", "resolution", "duration_seconds"],
            "properties": {
              "aspect_ratio": { "enum": ["9:16", "1:1", "16:9"] },
              "resolution": { "enum": ["1080x1920", "1080x1080", "1920x1080"] },
              "duration_seconds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 1 } }
            }
          },
          "pipeline": { "const": "media-graph-v1" },
          "initial_graph_node": { "const": "BRIEF" },
          "human_approval_required": { "const": true },
          "publication_action": { "const": "none" },
          "status": { "const": "PLANNED" }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["master-videos", "caption-drafts", "thumbnail-drafts", "provenance-manifest", "release-report"] }
    }
  }
}
